generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────

enum Role {
  HOSPITAL
  NGO
  BLOODBANK
  ADMIN
}

enum OrgType {
  HOSPITAL
  NGO
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum TicketStatus {
  PENDING
  CONFIRMED
  FULFILLED
  REJECTED
  EXPIRED
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum StockLevel {
  ADEQUATE
  LOW
  CRITICAL
}

// ─── Models ─────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role
  orgId         String?
  bloodBankId   String?
  state         String
  cityDistrict  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization  Organization? @relation(fields: [orgId], references: [id])
  bloodBank     BloodBank? @relation(fields: [bloodBankId], references: [bloodBankId])
}

model Organization {
  id            String   @id @default(uuid())
  name          String
  type          OrgType
  address       String
  state         String
  cityDistrict  String
  phone         String
  lat           Float?
  lng           Float?
  createdAt     DateTime @default(now())
  tier          String?
  focus         String?

  users         User[]
}

model Donor {
  donorId       String    @id @default(uuid())
  name          String
  contactNumber String
  bloodType     BloodType
  state         String
  cityDistrict  String
  registeredAt  DateTime  @default(now())

  bloodRecords  Blood[]

  @@index([state, cityDistrict])
}

model BloodBank {
  bloodBankId    String   @id @default(uuid())
  name           String
  address        String
  contactNumber  String
  state          String
  cityDistrict   String
  lat            Float?
  lng            Float?
  createdAt      DateTime @default(now())

  bloodRecords   Blood[]
  inventory      BloodInventory[]
  donationBatches DonationBatch[]  @relation("ReceivingBank")
  staff          User[]

  @@index([cityDistrict])
}

model Blood {
  bloodId        String       @id @default(uuid())
  bloodBankId    String
  donorId        String?
  state          String
  cityDistrict   String
  bloodType      BloodType
  dateDonated    DateTime?
  dateDemanded   DateTime?
  status         TicketStatus @default(PENDING)
  createdAt      DateTime     @default(now())

  bloodBank      BloodBank    @relation(fields: [bloodBankId], references: [bloodBankId])
  donor          Donor?       @relation(fields: [donorId], references: [donorId])
  demandTickets  DemandTicket[]
  donationBatches DonationBatch[]

  @@index([status, bloodBankId])
}

model DemandTicket {
  id             String       @id @default(uuid())
  hospitalId     String
  bloodId        String?
  bloodType      BloodType
  units          Int
  urgency        Urgency      @default(MEDIUM)
  department     String?
  requiredBy     DateTime?
  patientRefId   String?
  diagnosis      String?
  notes          String?
  status         TicketStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  blood          Blood?       @relation(fields: [bloodId], references: [bloodId])

  @@index([hospitalId, status, createdAt])
}

model DonationBatch {
  id              String       @id @default(uuid())
  ngoId           String
  bloodId         String?
  campName        String
  location        String
  date            DateTime
  bloodType       BloodType
  units           Int
  donorCount      Int          @default(0)
  receivingBankId String
  lotRef          String?
  notes           String?
  status          TicketStatus @default(PENDING)
  submittedAt     DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  blood           Blood?       @relation(fields: [bloodId], references: [bloodId])
  receivingBank   BloodBank    @relation("ReceivingBank", fields: [receivingBankId], references: [bloodBankId])

  @@index([ngoId, status, submittedAt])
  @@index([receivingBankId, status])
}

model BloodInventory {
  id            String     @id @default(uuid())
  bloodBankId   String
  bloodType     BloodType
  units         Int        @default(0)
  statusLevel   StockLevel @default(ADEQUATE)
  updatedAt     DateTime   @updatedAt

  bloodBank     BloodBank  @relation(fields: [bloodBankId], references: [bloodBankId])

  @@unique([bloodBankId, bloodType])
}

// Hospital-side fridge stock (per organisation + blood type).
model HospitalInventory {
  id            String     @id @default(uuid())
  hospitalId    String
  bloodType     BloodType
  units         Int        @default(0)
  statusLevel   StockLevel @default(ADEQUATE)
  updatedAt     DateTime   @updatedAt

  @@unique([hospitalId, bloodType])
}

enum MovementOwner {
  HOSPITAL
  BLOODBANK
}

enum MovementDirection {
  IN
  OUT
}

enum MovementReason {
  DONATION_CONFIRMED
  DEMAND_RECEIVED
  MANUAL_RECEIPT
  DISPATCH_TO_HOSPITAL
  TRANSFUSION_USED
  EXPIRED
  ADJUSTMENT
}

// Append-only stock ledger powering inventory analytics
// (gained/stored vs used/demanded) for hospitals and blood banks.
model StockMovement {
  id            String            @id @default(uuid())
  ownerKind     MovementOwner
  ownerId       String
  bloodType     BloodType
  direction     MovementDirection
  units         Int
  reason        MovementReason
  refId         String?
  note          String?
  createdAt     DateTime          @default(now())

  @@index([ownerKind, ownerId, createdAt])
}

model Camp {
  id            String   @id @default(uuid())
  name          String
  venue         String
  organizer     String
  date          DateTime
  startTime     String
  endTime       String
  tagType       String?
  state         String
  cityDistrict  String
  createdAt     DateTime @default(now())

  @@index([date])
}

enum RequestStatus {
  PENDING
  REVIEWED
  APPROVED
  DECLINED
}

// Public camp/account leads submitted via the registration form.
// Persisted (not fire-and-forget) so coordinators can follow up.
model AccountRequest {
  id               String        @id @default(uuid())
  organizationName String
  orgType          String?
  contactPerson    String
  email            String
  phone            String
  venue            String?
  cityDistrict     String?
  state            String?
  preferredDate    DateTime?
  expectedDonors   Int?
  status           RequestStatus @default(PENDING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model StatsSnapshot {
  id            String    @id @default(uuid())
  month         DateTime
  state         String
  cityDistrict  String
  bloodType     BloodType
  donated       Int       @default(0)
  demanded      Int       @default(0)
  forecast      Int       @default(0)

  @@unique([month, state, cityDistrict, bloodType])
}

// ─── ML forecasting pipeline ────────────────────────

// Raw ingested data (replaces/extends the CSV).
// bloodType is free text (raw source values, e.g. 'A+'), unlike the
// BloodType enum used elsewhere. Non-negativity is enforced by DB
// CHECK constraints (see below — Prisma has no CHECK attribute).
model BloodData {
  id            Int      @id @default(autoincrement())
  date          DateTime @db.Date
  state         String
  bloodType     String   @map("blood_type")
  unitsDonated  Int      @map("units_donated")
  unitsUsed     Int      @map("units_used")
  ingestedAt    DateTime @default(now()) @map("ingested_at")

  @@unique([date, state, bloodType])
  @@map("blood_data")
}

// Model version tracking — exactly one row should have isActive = true.
model ModelVersion {
  id         Int      @id @default(autoincrement())
  trainedAt  DateTime @default(now()) @map("trained_at")
  mae        Float?
  mape       Float?
  isActive   Boolean  @default(false) @map("is_active")
  filePath   String   @map("file_path")
  forecasts  Forecast[]

  @@map("model_versions")
}

// Latest forecast output — what dashboards read.
model Forecast {
  id                     Int           @id @default(autoincrement())
  modelVersionId         Int?          @map("model_version_id")
  date                   DateTime      @db.Date
  state                  String
  bloodType              String        @map("blood_type")
  predictedUnitsDonated  Float?        @map("predicted_units_donated")
  predictedUnitsUsed     Float?        @map("predicted_units_used")
  modelVersion           ModelVersion? @relation(fields: [modelVersionId], references: [id], onDelete: SetNull)

  @@map("forecasts")
}
